# ==============================
# .env — Environment Variables
# ==============================

# ---- General Environment ----
PROJECT_NAME=integrated_diffusion_rag_mcp
ENV=development
DEBUG=True

# ---- Data Paths ----
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
EMBEDDINGS_DIR=./data/embeddings
RETRIEVAL_INDEX_DIR=./data/retrieval_index
EXAMPLES_DIR=./data/examples

# ---- Experiment Outputs ----
EXPERIMENT_RESULTS_DIR=./experiments/results
EVALUATION_DIR=./evaluation
FRONTEND_DIR=./frontend

# ---- Model Checkpoints ----
HF_HOME=./models/hf_cache
DIFFUSION_MODEL=runwayml/stable-diffusion-v1-5
TEXT_EMBED_MODEL=sentence-transformers/all-mpnet-base-v2
IMAGE_EMBED_MODEL=openai/clip-vit-base-patch32
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---- API Keys ----
# Example (if you connect to HuggingFace / OpenAI APIs)
HUGGINGFACE_API_KEY=key

# ---- UI Config ----
FRONTEND_PORT=8501
FRONTEND_HOST=0.0.0.0

# ---- Evaluation Defaults ----
NUM_EVAL_SAMPLES=20
SAVE_FIGURES=True

# ---- Logging ----
LOG_LEVEL=INFO
LOG_DIR=./logs
